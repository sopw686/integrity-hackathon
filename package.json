{
  "name": "read-the-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A two-minute daily game: five claims, your verdict, and your read of the room.",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "validate": "tsx scripts/validate-content.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check:flows": "tsx scripts/check-flows.ts",
    "compose-days": "tsx scripts/compose-days.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "motion": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
